            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/saude",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "saude"
          ]
        }
      }
    },
